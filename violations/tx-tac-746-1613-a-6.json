as observed supervising a group of children during naptime. There was not another caregiver present in the building  to answer the door to parents without a caregiver having to leave the classroom.","count":1},{"text":"During an investigation it was found that a caregiver went on break. Another caregiver supervied two different classrooms during this time, walking back and forth to each classroom","count":1},{"text":"A caregiver was supervising a total of 16 chidren of varying ages that were napping in two different rooms.","count":1},{"text":"Upon arrival the caregiver was not physically present in the nap room.","count":1}],"topic":"supervision","topic_label":"Supervision & ratios","topic_evidence":"INFERRED","primary_severity":"medium_high","occurrence_count":40,"facility_count":38},"by_year":{"2021":2,"2022":10,"2023":6,"2024":4,"2025":7,"2026":11},"facilities":[{"id":"tx-hhsc-1262264","name":"Horn's Academy Child Care Center","type":"center","authority":"TX HHSC","status":"licensed","city":"Waco","zip":"76707","address":"1511 Bosque Blvd","capacity":70,"age_groups":["infant","toddler","preschool","school_age"],"lat":31.55570213265,"lon":-97.149197480935,"inspections":48,"last_inspection":"2026-10-22","violations":39,"open_violations":0,"severe_violations":30,"occurrences_of_type":2,"open_of_type":0},{"id":"tx-hhsc-1428506","name":"The Escuelita Learning Center","type":"center","authority":"TX HHSC","status":"licensed","city":"Brownsville","zip":"78521","address":"334 Morningside Rd","capacity":51,"age_groups":["infant","toddler","preschool","school_age"],"lat":25.903154114939,"lon":-97.448022232495,"inspections":16,"last_inspection":"2026-04-23","violations":15,"open_violations":0,"severe_violations":11,"occurrences_of_type":2,"open_of_type":0},{"id":"tx-hhsc-1122360","name":"Kidz Stay N' Play","type":"center","authority":"TX HHSC","status":"licensed","city":"Nevada","zip":"75173","address":"535 E Fm 6","capacity":145,"age_groups":["infant","toddler","preschool
{"violation_type":{"id":"tx-tac-746-1203-3-a","jurisdiction":"TX","state":"TX","code_system":"Texas Administrative Code, Title 26, Ch. 746","original_code":"746.1203(3)(A)","title":"Administrative and clerical duties that take caregiver's attention away from children (26 TAC §746.1203(3)(A))","short_title":"Administrative and clerical duties that take caregiver's attention away from children","severities":{"medium_high":37},"facility_ids":["tx-hhsc-1375959","tx-hhsc-1247130","tx-hhsc-1498635","tx-hhsc-1295066","tx-hhsc-1492355","tx-hhsc-1123311","tx-hhsc-1445151","tx-hhsc-1467550","tx-hhsc-1180100","tx-hhsc-1454834","tx-hhsc-1366137","tx-hhsc-1280000","tx-hhsc-1331285","tx-hhsc-1292102","tx-hhsc-1159992","tx-hhsc-1495832","tx-hhsc-1517083","tx-hhsc-1480929","tx-hhsc-1332125","tx-hhsc-1372785","tx-hhsc-1480747","tx-hhsc-1309181","tx-hhsc-1273523","tx-hhsc-1485936","tx-hhsc-397308","tx-hhsc-1332361","tx-hhsc-151737","tx-hhsc-1515066","tx-hhsc-1474911","tx-hhsc-1445752","tx-hhsc-165274","tx-hhsc-1337465","tx-hhsc-1327569","tx-hhsc-1516851"],"first_date":"2023-05-22","last_date":"2026-09-16","typical_finding":"The caregiver was working on paperwork. It was during nap/rest period, and most all of the children were awake.","finding_variants":[{"text":"The caregiver was working on paperwork. It was during nap/rest period, and most all of the children were awake.","count":2},{"text":"The director was counted in ratio as a cargiver performing administrative and clerical duties while supervising children in care.","count":2},{"text":"Based on the information gathered throughout this investigation, it has been concluded that the caregiver was doing clerical work while caring for children instead of following the classroom's lesson plan and schedule.","count":1},{"text":"Both caregivers present had to participate in activities that kept them from supervising children such as opening the door and preparing lunch. They had to leave children unattended multiple times throughout the inspection.","count":1},{"text":"This standard was found to be out of compliance when a caregiver was distracted with paperwork and did not intervene in time to prevent a child injury.","count":1},{"text":"This standard was evaluated and found to be out of compliance. It was determined that caregivers have been observed working on clerical duties while children are out of control in the classroom, not noticing children being picked up or supervising what children are doing.","count":1}],"topic":"supervision","topic_label":"Supervision & ratios","topic_evidence":"INFERRED","primary_severity":"medium_high","occurrence_count":37,"facility_count":34},"by_year":{"2023":10,"2024":7,"2025":5,"2026":15},"facilities":[{"id":"tx-hhsc-1180100","name":"Texas Kids Childcare","type":"center","authority":"TX HHSC","status":"licensed","city":"Katy","zip":"77449","address":"2520 N Mason Rd","capacity":307,"age_groups":["infant","toddler","preschool","school_age"],"inspections":52,"last_inspection":"2026-08-28","violations":34,"open_violations":0,"severe_violations":19,"occurrences_of_type":2,"open_of_type":0},{"id":"tx-hhsc-1454834","name":"High Achievers Learning Center","type":"center","authority":"TX HHSC","status":"licensed","city":"La Porte","zip":"77571","address":"10001 Spencer Hwy","capacity":127,"age_groups":["infant","toddler","preschool","school_age"],"inspections":30,"last_inspection":"2026-07-22","violations":35,"open_violations":0,"severe_violations":24,"occurrences_of_type":2,"open_of_type":0},{"id":"tx-hhsc-1480747","name":"Inwood Daycare & Learning Center","type":"center","authority":"TX HHSC","status":"licensed","city":"Houston","zip":"77088","address":"8021 Antoine Dr Ste a","capacity":160,"age_groups":["infant","toddler","preschool","school_age"],"lat":29.885148908231,"lon":-95.474036002627,"inspections":36,"last_inspection":"2026-10-13","violations":35,"open_violations":0,"severe_violations":25,"occurrences_of_type":2,"open_of_type":0},{"id":"tx-hhsc-1375959",
{"violation_type":{"id":"tx-tac-744-805-2","jurisdiction":"TX","state":"TX","code_system":"Texas Administrative Code, Title 26, Ch. 744","original_code":"744.805(2)","title":"Electronic Records- Accessible to Caregivers (26 TAC §744.805(2))","short_title":"Electronic Records- Accessible to Caregivers","severities":{"medium":9},"facility_ids":["tx-hhsc-1280846","tx-hhsc-278625","tx-hhsc-1334662","tx-hhsc-1334702","tx-hhsc-1455279","tx-hhsc-1509736","tx-hhsc-1416734"],"first_date":"2022-12-05","last_date":"2026-03-04","typical_finding":"The caregiver in charge does not have access to children's records.","finding_variants":[{"text":"The caregiver in charge does not have access to children's records.","count":2},{"text":"Based on information obtained through the investigation, it was found that caregivers at the site did not have access to the electronic records. The paper files at the site were not updated to reflect added persons to the authorized pick up list for a child.","count":1},{"text":"Two inspections have been conducted at the operation and children recordings have not been accessible.","count":1},{"text":"At the time of inspection electronic child records were only available to 1 of 13 staff. Only 9 of 69 children in care had paper files available on site.","count":1},{"text":"During the inspection, the site director was unable to access the children's records.","count":1},{"text":"The site director did not know how to access children's admission records.     CI: The site director called to the program director to get instructions on how to access the records during the inspection.","count":1}],"topic":"supervision","topic_label":"Supervision & ratios","topic_evidence":"INFERRED","primary_severity":"medium","occurrence_count":9,"facility_count":7},"by_year":{"2022":1,"2024":2,"2025":5,"2026":1},"facilities":[{"id":"tx-hhsc-1280846","name":"Alphabest @ Clara Love - Northwest","type":"school_age","authority":"TX HHSC","status":"licensed","city":"Justin","zip"
{"violation_type":{"id":"tx-tac-746-201-2","jurisdiction":"TX","state":"TX","code_system":"Texas Administrative Code, Title 26, Ch. 746","original_code":"746.201(2)","title":"Written Personnel Policies (26 TAC §746.201(2))","short_title":"Written Personnel Policies","severities":{"medium_high":20},"facility_ids":["tx-hhsc-1467110","tx-hhsc-1391352","tx-hhsc-298169","tx-hhsc-1393387","tx-hhsc-1323027","tx-hhsc-233359","tx-hhsc-1536075","tx-hhsc-1400760","tx-hhsc-1419414","tx-hhsc-1338151","tx-hhsc-1498418","tx-hhsc-137000","tx-hhsc-1390635","tx-hhsc-1501177","tx-hhsc-1355803","tx-hhsc-1330424","tx-hhsc-1479923","tx-hhsc-107998","tx-hhsc-1415666","tx-hhsc-1521712"],"first_date":"2021-11-19","last_date":"2026-10-16","typical_finding":"Personnel policies were not available for review during the inspection.","finding_variants":[{"text":"Personnel policies were not available for review during the inspection.","count":1},{"text":"The operational policies were evaluated and lacked written policies for: 1) Promotion of indoor and outdoor physical activity that is consistent with Subchapter F of this chapter; 2) Procedures for providing and applying, as needed, insect repellent and sunscreen; 3) provisions to provide a comfortable place with an adult sized seat in the center or within a classroom that enables a mother to breastfeed her child; information regarding whether or not you will require employees to obtain vaccines for preventable diseases; and 4). The HHSC website (hhs.texas.gov).","count":1},{"text":"The operational policies did not include the following:  The hours, days and months the operation is open.  Indoor and outdoor activities.  Parents have the right to visit the center at any time during operating hours without prior approval.","count":1},{"text":"Written policies were not available for review during the inspection.","count":1},{"text":"The personnel policies were not available for review at time of inspection.","count":1},{"text":"Personnel policies related to staff being ill not having direct access to children in care is not being adhered to. A staff member at inspection stated they had to come to work sick and was working in a classroom with children in care.","count":1}],"topic":"supervision","topic_label":"Supervision & ratios","topic_evidence":"INFERRED","primary_severity":"medium_high","occurrence_count":20,"facility_count":20},"by_year":{"2021":2,"2022":6,"2023":2,"2024":4,"2025":3,"2026":3},"facilities":[{"id":"tx-hhsc-1467110","name":"Carrusel Daycare Center","type":"center","authority":"TX HHSC","status":"licensed","city":"Mission","zip":"78572","address":"423 N Conway Ave","capacity":95,"age_groups":["infant","toddler","preschool","school_age"],"lat":26.209830851004,"lon":-98.326827672309,"inspections":12,"last_inspection":"2026-10-20","violations":13,"open_violations":0,"severe_violations":6,"occurrences_of_type":1,"open_of_type":0},{"id":"tx-hhsc-1391352","name":"Tutu's & Buckaroo's Childcare Center","type":"center","authority":"TX HHSC","status":"licensed","city":"Mount Pleasant","zip":"75455","address":"105 W Pecan St","capacity":60,"age_groups":["infant","toddler","preschool","school_age"],"lat":33.14476213385,"lon":-94.96869309358,"inspections":25,"last_inspection":"2026-08-13","violations":12,"open_violations":0,"severe_violations":10,"occurrences_of_type":1,"open_of_type":0},{"id":"tx-hhsc-298169","name":"Fumcr-Preschool","type":"center","authority":"TX HHSC","status":"licensed","city":"Richardson","zip":"75080","address":"503 N Central Expy","capacity":300,"age_groups":["infant","toddler","preschool","school_age"],"lat":32.955538699277,"lon":-96.732078895599,"inspections":6,"last_inspection":"2026-04-22","violations":2,"open_violations":0,"severe_violations":2,"occurrences_of_type":1,"open_of_type":0},{"id":"tx-hhsc-1393387","name":"Journey of Faith Christian Learning Center","type":"center","authority":"TX HHSC","status":"licensed","city":"Cedar Hill","zip":"75104","address":"321 Cooper St","
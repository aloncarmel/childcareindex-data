{"violation_type":{"id":"tx-tac-746-4409","jurisdiction":"TX","state":"TX","code_system":"Texas Administrative Code, Title 26, Ch. 746","original_code":"746.4409","title":"Location of Toilets (26 TAC §746.4409)","short_title":"Location of Toilets","severities":{"medium":8},"facility_ids":["tx-hhsc-422868","tx-hhsc-1190718","tx-hhsc-95322","tx-hhsc-1354579","tx-hhsc-228214","tx-hhsc-102385","tx-hhsc-1381934","tx-hhsc-228987"],"first_date":"2021-11-10","last_date":"2026-08-25","typical_finding":"During the investigation inspection it was found that the school age bathroom was not equipped with toilet paper and the caregiver did not have access to get any to replace it.","finding_variants":[{"text":"During the investigation inspection it was found that the school age bathroom was not equipped with toilet paper and the caregiver did not have access to get any to replace it.","count":1},{"text":"The operation used portable potty chairs in the outdoor play area.","count":1},{"text":"In one classroom there was no toilet paper for the children to have indipendent use. I spoke to the director and caregiver about having toilet paper for the children.","count":1},{"text":"Observed a bathroom that had mats, toys and other equipment that stacked half way up the wall and on top of the sink and toilet and could not safely be used by any children. This bathroom is also a emergency evacuation room.","count":1},{"text":"Two toilets in a 4 year old classroom did not have toilet paper available to be used.","count":1},{"text":"Children are not able to safely access the toilet in the toddler classroom.","count":1}],"topic":"supervision","topic_label":"Supervision & ratios","topic_evidence":"INFERRED","primary_severity":"medium","occurrence_count":8,"facility_count":8},"by_year":{"2021":1,"2022":1,"2023":2,"2024":2,"2025":1,"2026":1},"facilities":[{"id":"tx-hhsc-422868","name":"Little Crusaders Christian Preschool","type":"center","authority":"TX HHSC","status":"licensed","city":"Liberty
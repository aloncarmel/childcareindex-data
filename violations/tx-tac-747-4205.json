{"violation_type":{"id":"tx-tac-747-4205","jurisdiction":"TX","state":"TX","code_system":"Texas Administrative Code, Title 26, Ch. 747","original_code":"747.4205","title":"Supply Soap and Individual Towels (26 TAC §747.4205)","short_title":"Supply Soap and Individual Towels","severities":{"medium":8},"facility_ids":["tx-hhsc-330566","tx-hhsc-1528027","tx-hhsc-1340653","tx-hhsc-1264771","tx-hhsc-1093424","tx-hhsc-1359567","tx-hhsc-1376787","tx-hhsc-301967"],"first_date":"2022-02-10","last_date":"2026-09-30","typical_finding":"There are no paper towels in the bathroom. A single towel was provided for all the children to dry their hands.","finding_variants":[{"text":"There are no paper towels in the bathroom. A single towel was provided for all the children to dry their hands.","count":1},{"text":"Upon arrival at the home the restroom labeled for daycare children did not have paper towels or handsoap present. The provider did order the items during the inspection and placed both the paper towels and handsoap in the area.","count":1},{"text":"There were no individual towels or disposable towels observed in restroom for handwashing and drying during inspection.","count":1},{"text":"There were no paper towels or single use towels for the children to dry their hands with after washing their hands. Paper towels were provided to the children.","count":1},{"text":"The bathroom sink used by children had one hand towel and not single use disposable towels or individually labeled towels as required.    This was corrected at inspection when the provider add paper towels to the bathroom.","count":1},{"text":"The hand washing sink in the bathroom was not equipped with individual hand towels. The children were all using the same towel.","count":1}],"topic":"sanitation","topic_label":"Sanitation & hygiene","topic_evidence":"INFERRED","primary_severity":"medium","occurrence_count":8,"facility_count":8},"by_year":{"2022":3,"2023":2,"2024":2,"2026":1},"facilities":[{"id":"tx-hhsc-330566
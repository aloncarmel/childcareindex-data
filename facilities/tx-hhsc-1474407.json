07(1)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Corrected at inspection","finding":"Storage of Medication - Inaccessible to Children: An over the counter medicine was in a ziplock on top of a highchair in an empty classroom. This was corrected at the inspection when the person in charge removed it and stored it.","topic":"health","source_record_id":"1026450966","violation_type_title":"Storage of Medication - Inaccessible to Children (26 TAC §746.3807(1))","topic_label":"Health records & medication"},{"id":"tx-hhsc-1474407-i20240617-v3","violation_type_id":"tx-tac-746-2421-a","inspection_id":"tx-hhsc-1474407-i20240617","date":"2024-06-17","original_code":"746.2421(a)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2024-06-24","finding":"Written Feeding Instructions - Signed and Dated by Parent or Health-Care Professional: There were no written feeding instructions forms for the infants in care.","topic":"food","source_record_id":"1026330847","violation_type_title":"Written Feeding Instructions - Signed and Dated by Parent or Health-Care Professional (26 TAC §746.2421(a))","topic_label":"Food & nutrition"}]},{"id":"tx-hhsc-1474407-i20240319","date":"2024-03-19","inspection_type":"Inspection","result":"Deficiencies cited","passed":false,"violation_count":4,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905879604","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905879604","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2024-03-19","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1474407-i20240319-v1","violation_type_id":"tx-tac-746-1315-a","inspection_id":"tx-hhsc-1474407-i20240319","date":"2024-03-19","original_code":"746.1315(a)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2024-03-21","findin
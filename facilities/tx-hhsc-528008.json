idence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905787888","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905787888","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2023-11-01","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-528008-i20231101-v1","violation_type_id":"tx-tac-744-1601","inspection_id":"tx-hhsc-528008-i20231101","date":"2023-11-01","original_code":"744.1601","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2023-11-17","finding":"Child/ Caregiver Ratio: Upon arrival, two caregivers were observed with a total of 42 children, 5-9 years of age. The children were observed in an open gym area, and outdoor area.  At 4:13PM, a total of 33 children were observed in care with two staff.  At 4:18PM, a total of 29 children, 5-9 years of age were observed with Staff B.","topic":"supervision","source_record_id":"1026268985","violation_type_title":"Child/ Caregiver Ratio (26 TAC §744.1601)","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-528008-i20231101-v2","violation_type_id":"tx-tac-744-1309-a-2","inspection_id":"tx-hhsc-528008-i20231101","date":"2023-11-01","original_code":"744.1309(a)(2)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2023-12-05","finding":"Documented Annual Training-15 Hours Required Site Director: During the follow-up inspection, the training topics were not available for Licensing.  A total of 8 out of the required 15 training hours were observed for the Site Director. The Site Director did not obtain training topics related to the Health and Safety audit. The Site Director lacked training topics related to emergency preparedness, administering medication, and/or handling, storing, and disposing of hazardous materials.","topic":"staffing","source_record_id":"1026229007","violation_type_title":"Documented Annual Training-15 Hours Required Site Director (26 TAC §744.1309(a)(2))","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-528008-i20231101-v3","violation_type_id":"tx-tac-744-1205-a-4","inspection_id":"tx-hhsc-528008-i20231101","date":"2023-11-01","original_code":"744.1205(a)(4)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2023-11-17","finding":"Supervision ensures each child?s safety, well-being, including physical proximity and auditory or visual awareness of each child?s on going activity: Two staff were observed during the follow-up inspection with a total of 42 children.   Staff A was observed retrieving children from outdoors for parent pick-up, leaving the children indoors unattended.  Staff A walked out of the gym area to the entry door in order for parents/guardians to sign their child out for the day.  A total of 23 children were left unattended while Staff B was outside.  Staff B was observed walking into the gym area/building, leaving two children outdoors unattended to finish their snack. Licensing staff witnessed several supervision incidents during the follow-up inspection.","topic":"supervision","source_record_id":"1026429730","violation_type_title":"Supervision ensures each child?s safety, well-being, including physical proximity and auditory or visual awareness of each child?s on going activity (26 TAC §744.1205(a)(4))","topic_label":"Supervision & ratios"}]},{"id":"tx-hhsc-528008-i20231018","date":"2023-10-18","inspection_type":"Inspection","result":"Deficiencies cited","passed":false,"violation_count":3,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905787887","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905787887","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2023-10-18","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-528008-i20231018-v1","violation_type_id":"tx-tac-744-1309-a-2","in
","finding":"Required Admission Information-Completed Food Allergy Plan: Two children's records indicated a food allergy on the enrollment record but did not have a complete food allergy plan on file.","topic":"health","source_record_id":"1026531380","violation_type_title":"Required Admission Information-Completed Food Allergy Plan (26 TAC §746.605(16))","topic_label":"Health records & medication"},{"id":"tx-hhsc-94161-i20230825-v2","violation_type_id":"tx-tac-746-3415-4","inspection_id":"tx-hhsc-94161-i20230825","date":"2023-08-25","original_code":"746.3415(4)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2023-09-01","finding":"Employee Handwashing After Diapering a Child: An employee was observe at inspection changing consecutive diaper changes and did not wash their hands in between at the hand washing sink.","topic":"staffing","source_record_id":"1026451116","violation_type_title":"Employee Handwashing After Diapering a Child (26 TAC §746.3415(4))","topic_label":"Staff qualifications & clearances"}]},{"id":"tx-hhsc-94161-i20230201","date":"2023-02-01","inspection_type":"Inspection","result":"Deficiencies cited","passed":false,"violation_count":1,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905740036","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905740036","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2023-02-01","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-94161-i20230201-v1","violation_type_id":"tx-tac-746-1316-a","inspection_id":"tx-hhsc-94161-i20230201","date":"2023-02-01","original_code":"746.1316(a)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2023-02-09","finding":"Transportation Safety Training -Director and Employee Complete 2 Hours Annually: The director did not have transportation training availa
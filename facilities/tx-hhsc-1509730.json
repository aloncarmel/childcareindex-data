ty - Areas Free From Hazards: This standard was evaluated as part of the investigation and was found to be deficient. Through interviews with staff, it was determined that the cover on a hose connection box was broken on the playground. The box was not blocked off from children when a child received a minor injury from the box.","topic":"safety","source_record_id":"1026600824","violation_type_title":"Safety - Areas Free From Hazards (26 TAC §746.3701)","topic_label":"Safety hazards"},{"id":"tx-hhsc-1509730-i20260226-v3","violation_type_id":"tx-tac-746-1205-a-5","inspection_id":"tx-hhsc-1509730-i20260226","date":"2026-02-26","original_code":"746.1205(a)(5)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2026-03-31","finding":"Responsibilities of Caregivers - Intervene to ensure each child's safety: This standard was evaluated as part of the investigation and was found to be deficient. Through interviews with staff, it was determined that caregivers and administrative staff were aware of a broken cover for a hose connection box on the playground; however, the caregivers did not have an increased level of supervision for the box and as a result a child received a minor injury from the hose connection box.","topic":"supervision","source_record_id":"1026600829","violation_type_title":"Responsibilities of Caregivers - Intervene to ensure each child's safety (26 TAC §746.1205(a)(5))","topic_label":"Supervision & ratios"}]},{"id":"tx-hhsc-1509730-i20251202","date":"2025-12-02","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905891113","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905891113","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2025-12-02","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1509730-i20251104",
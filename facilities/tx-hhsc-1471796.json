se,"violation_count":3,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905951286","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905951286","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2024-03-27","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1471796-i20240327-v1","violation_type_id":"tx-tac-746-1205-a-4","inspection_id":"tx-hhsc-1471796-i20240327","date":"2024-03-27","original_code":"746.1205(a)(4)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2024-04-26","finding":"Supervision ensures each child?s safety, well-being, including physical proximity and auditory or visual awareness of each child?s on going activity: Through the course of investigation it was found that a child was left alone outside on the playground area for approximately 5 minutes unsupervised. The caregiver responsible did not account for the children in the group they were responsible for as they entered the building, nor did they scan the playground for any remaining children as they entered. The caregiver was unaware the child was missing until they entered the classroom and accounting for children was conducted. When the caregiver called to notify the office staff they were missing a child they did not know if the child was left on the playground or had left the group into another classroom as they went through the building.","topic":"supervision","source_record_id":"1026648912","violation_type_title":"Supervision ensures each child?s safety, well-being, including physical proximity and auditory or visual awareness of each child?s on going activity (26 TAC §746.1205(a)(4))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1471796-i20240327-v2","violation_type_id":"tx-tac-746-1003-3","inspection_id":"tx-hhsc-1471796-i20240327","date":"2024-03-27","original_code":"746.1003(3)","severity":"high","severity_label":"High risk","sta
:4,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905813201","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905813201","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2023-06-21","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1250531-i20230621-v1","violation_type_id":"tx-tac-746-3819","inspection_id":"tx-hhsc-1250531-i20230621","date":"2023-06-21","original_code":"746.3819","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2023-06-27","finding":"Food Allergy Emergency Plan Signed by Parents and Health Care Professional: A child that has a diagnosed food allergy to shellfish and strawberries was lacking an allergy emergency plan signed by both the parent and the physician.","topic":"fire","source_record_id":"1026233599","violation_type_title":"Food Allergy Emergency Plan Signed by Parents and Health Care Professional (26 TAC §746.3819)","topic_label":"Fire safety & emergency drills"},{"id":"tx-hhsc-1250531-i20230621-v2","violation_type_id":"tx-tac-746-5205-1","inspection_id":"tx-hhsc-1250531-i20230621","date":"2023-06-21","original_code":"746.5205(1)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2023-07-18","finding":"Fire Drill Monthly - Exit in 3 Minutes: Upon review of drills, a fire drill had not been documented since April 26, 2023.     This was corrected at inspection when the operation conducted a fire drill and then documented the drill bringing the operation back into compliance.","topic":"supervision","source_record_id":"1026233598","violation_type_title":"Fire Drill Monthly - Exit in 3 Minutes (26 TAC §746.5205(1))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1250531-i20230621-v3","violation_type_id":"tx-tac-746-1315-b","inspection_id":"tx-hhsc-1250531-i20230621","date":"2023-06-21","original_code":"746.1315(b)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2023-06-27","finding":"Each Caregiver and the Director Must Have Current Training in pediatric CPR: The director was lacking a current First Aid and CPR certification.","topic":"staffing","source_record_id":"1026233600","violation_type_title":"Each Caregiver and the Director Must Have Current Training in pediatric CPR (26 TAC §746.1315(b))","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-1250531-i20230621-v4","violation_type_id":"tx-tac-746-3407","inspection_id":"tx-hhsc-1250531-i20230621","date":"2023-06-21","original_code":"746.3407","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2023-07-18","finding":"Maintenance of Building, Grounds and Equipment: The toddler room was observed to have Clorox wipes sitting on the top of the toilet and accessible to children in care. The toilet seat had dried urine on it along with feces stains in the toilet bowl. Furthermore, the outdoor area had 2 water hoses that were draped and hanging over the fence causing a possible strangulation or entrapment hazard to children in care. A large plastic mat inside the sandbox on the toddler playground contains several rips and tears presenting a tripping hazard to children in care.     This was corrected at inspection when the Clorox wipes were placed out of reach of children and the toilet was cleaned. The hoses were removed from the fence and placed behind a barrier bringing the operation back in to compliance.","topic":"supervision","source_record_id":"1026474071","violation_type_title":"Maintenance of Building, Grounds and Equipment (26 TAC §746.3407)","topic_label":"Supervision & ratios"}]},{"id":"tx-hhsc-1250531-i20220718","date":"2022-07-18","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VE
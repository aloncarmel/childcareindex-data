 investigation findings, this standard was reviewed and found to be in non-compliance with The Minimum Standards for Child Care Centers. On 06/09/2025 the operation went on a field trip to a water park where there were twenty-four children with three staff members in the wading pool areas. The youngest children on the field trip were three years olds; the operation was over ratio by six children.","topic":"supervision","source_record_id":"1026588850","violation_type_title":"Child/Caregiver Ratio - Splashing/Wading Activities (26 TAC §746.2101(a))","topic_label":"Supervision & ratios"}]},{"id":"tx-hhsc-372177-i20250520","date":"2025-05-20","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905785149","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905785149","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2025-05-20","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-372177-i20250425","date":"2025-04-25","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905785148","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905785148","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2025-04-25","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-372177-i20250423","date":"2025-04-23","inspection_type":"Investigation of a report","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905918011","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905918011","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2025-04-23","evidence_class":"VERIFIED"},"occu
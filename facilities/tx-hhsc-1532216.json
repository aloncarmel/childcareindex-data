0624","date":"2026-06-24","original_code":"746.5015(c)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Corrected at inspection","finding":"Safety Requirements for Sprinkler Play - Equipment and Water Hoses Kept Out of Child's Reach: At the time of inspection, a water hose was observed on the toddler playground which was accessible to children. This was corrected at inspection by staff removing the hose and storing it in area inaccessible to children.","topic":"safety","source_record_id":"1026450661","violation_type_title":"Safety Requirements for Sprinkler Play - Equipment and Water Hoses Kept Out of Child's Reach (26 TAC §746.5015(c))","topic_label":"Safety hazards"},{"id":"tx-hhsc-1532216-i20260624-v4","violation_type_id":"tx-tac-746-501-a-23","inspection_id":"tx-hhsc-1532216-i20260624","date":"2026-06-24","original_code":"746.501(a)(23)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2026-07-09","finding":"Written Operational Policies - Procedures parents access minimum standards online, TX A/N hotline, and HHSC website: At the time of inspeciton the operational policies did not include procedures for parents to access the minimum standards online. The policies did not include the Texas Abuse/Neglect hotline number or the HHSC website.","topic":"supervision","source_record_id":"1026530949","violation_type_title":"Written Operational Policies - Procedures parents access minimum standards online, TX A/N hotline, and HHSC website (26 TAC §746.501(a)(23))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1532216-i20260624-v5","violation_type_id":"tx-tac-746-501-a-15","inspection_id":"tx-hhsc-1532216-i20260624","date":"2026-06-24","original_code":"746.501(a)(15)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2026-07-09","finding":"Written Operational Policies - Water Activities: At the time of inspection the operational policies did not include informaiton ro policies regarding water activities.","topic":"supervision","source_record_id":"1026410776","violation_type_title":"Written Operational Policies - Water Activities (26 TAC §746.501(a)(15))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1532216-i20260624-v6","violation_type_id":"tx-tac-746-501-a-18-b","inspection_id":"tx-hhsc-1532216-i20260624","date":"2026-06-24","original_code":"746.501(a)(18)(B)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2026-07-09","finding":"Written Operational Policies - Duration: At the time of inspection the operational policies did not include the duration of indoor/outdoor physical activity.","topic":"supervision","source_record_id":"1026490541","violation_type_title":"Written Operational Policies - Duration (26 TAC §746.501(a)(18)(B))","topic_label":"Supervision & ratios"}]}],"geo":{"state":{"code":"TX","name":"Texas"},"county":{"fips":"48439","name":"Tarrant County"},"zip":"76182","city":"North Richland Hills"},"related":{"same_operator":[],"same_operator_total":0,"same_building":[],"same_address_other_authority":[],"nearby":[{"id":"tx-hhsc-1489579","name":"Early Care and Education","type":"center","city":"North Richland Hills","zip":"76182","capacity":352,"violations":7,"open_violations":0,"status":"licensed","distance_km":0.57},{"id":"tx-hhsc-1497224","name":"Life Academy","type":"center","city":"North Richland Hills","zip":"76182","capacity":87,"violations":10,"open_violations":0,"status":"licensed","distance_km":0.81},{"id":"tx-hhsc-924931","name":"Kidsville INC. Green Valley Elementary","type":"school_age","city":"North Richland Hills","zip":"76182","capacity":50,"violations":3,"open_violations":0,"status":"licensed","distance_km":0.92},{"id":"tx-hhsc-98335","name":"Little Tyke - Smithfield Rd","type":"center","city":"North Richland Hills","zip":"76182","capacity":120,"violations":19,"open_viola
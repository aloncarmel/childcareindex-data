nspection","result":"Deficiencies cited","passed":false,"violation_count":3,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905872749","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905872749","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2026-02-20","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1459393-i20260220-v1","violation_type_id":"tx-tac-746-3415-4","inspection_id":"tx-hhsc-1459393-i20260220","date":"2026-02-20","original_code":"746.3415(4)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2026-02-25","finding":"Employee Handwashing After Diapering a Child: A caregiver did not wash hands with soap and running water after changing a child's diaper but instead guided the child to enage in a table activity.  When CCR inspector brought hand washing to her attention, the caregiver washed their hands with soap and running water.","topic":"staffing","source_record_id":"1026420300","violation_type_title":"Employee Handwashing After Diapering a Child (26 TAC §746.3415(4))","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-1459393-i20260220-v2","violation_type_id":"tx-tac-746-1609","inspection_id":"tx-hhsc-1459393-i20260220","date":"2026-02-20","original_code":"746.1609","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2026-02-25","finding":"Maximum Group Size 13 or More Children: A caregiver was observed supervising 14 children ranging from 17 months to 2 years with a Specified Age Group of 18 to 23 months.  The ratio for 18 to 23 months is 9:1.  The director corrected the deficiency during the inspection by adding a second qualified caregiver in the class to mitigate risk.","topic":"supervision","source_record_id":"1026340021","violation_type_title":"Maximum Group Size 13 or More Children (26 TAC §746.1609)","
)","topic_label":"Other"}]},{"id":"tx-hhsc-1475158-i20250711","date":"2025-07-11","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905879931","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905879931","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2025-07-11","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1475158-i20250702","date":"2025-07-02","inspection_type":"Investigation of a report","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905951689","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905951689","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2025-07-02","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1475158-i20250610","date":"2025-06-10","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905879930","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905879930","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2025-06-10","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1475158-i20250606","date":"2025-06-06","inspection_type":"Investigation of a report (self-reported)","result":"Deficiencies cited","passed":false,"violation_count":1,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905951688","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905951688","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2025-06-06","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1475158-i20250606-v1","violation_type_id
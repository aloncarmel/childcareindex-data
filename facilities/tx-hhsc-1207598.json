.","topic":"supervision","source_record_id":"1026340304","violation_type_title":"Two Exits Located in Distant Parts (26 TAC §747.5011(a))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1207598-i20251110-v3","violation_type_id":"tx-tac-747-3203","inspection_id":"tx-hhsc-1207598-i20251110","date":"2025-11-10","original_code":"747.3203","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2025-12-05","finding":"Sanitation of Building, Grounds and Equipment: Outdoor activity space had a trailer parked with items going to storage. A pile of branches was in the activity space. Metal chain link pieces from the new fence were located on the ground in the activity space.","topic":"sanitation","source_record_id":"1026380644","violation_type_title":"Sanitation of Building, Grounds and Equipment (26 TAC §747.3203)","topic_label":"Sanitation & hygiene"},{"id":"tx-hhsc-1207598-i20251110-v4","violation_type_id":"tx-tac-747-4105","inspection_id":"tx-hhsc-1207598-i20251110","date":"2025-11-10","original_code":"747.4105","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2025-12-05","finding":"Fenced Outdoor Activity Space: Some areas of the outdoor space accessible to children had perimeter fencing that was under 4 feet high. The areas on the other sides of the fence led to other property, including property with 2 large dogs that appeared possibly aggressive. The home is also within proximity to a lake.","topic":"safety","source_record_id":"1026460569","violation_type_title":"Fenced Outdoor Activity Space (26 TAC §747.4105)","topic_label":"Safety hazards"}]},{"id":"tx-hhsc-1207598-i20241118","date":"2024-11-18","inspection_type":"Assessment","result":"Deficiencies cited","passed":false,"violation_count":1,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905958500","url":"https://data.t
y_id=905856253","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2025-03-07","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1393773-i20250307-v1","violation_type_id":"tx-tac-746-1315-a","inspection_id":"tx-hhsc-1393773-i20250307","date":"2025-03-07","original_code":"746.1315(a)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2025-03-24","finding":"Each Caregiver and the Director Must Have Current Training in pediatric first aid with rescue breathing and choking.: Out of 4 caregiver files reviewed, 2 caregiver were missing first aid training.","topic":"staffing","source_record_id":"1026303256","violation_type_title":"Each Caregiver and the Director Must Have Current Training in pediatric first aid with rescue breathing and choking. (26 TAC §746.1315(a))","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-1393773-i20250307-v2","violation_type_id":"tx-tac-746-5205-2","inspection_id":"tx-hhsc-1393773-i20250307","date":"2025-03-07","original_code":"746.5205(2)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2025-03-14","finding":"Sheltering Drill For Severe Weather-Four times a calendar year: The last calendar year only had 2 of the 4 required lock down drills and 2 of the 4 required severe weather drills. This was partially corrected at inspection when the operation completed a lock down drill and a severe weather drill.","topic":"supervision","source_record_id":"1026263059","violation_type_title":"Sheltering Drill For Severe Weather-Four times a calendar year (26 TAC §746.5205(2))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1393773-i20250307-v3","violation_type_id":"tx-tac-746-3805-b-3","inspection_id":"tx-hhsc-1393773-i20250307","date":"2025-03-07","original_code":"746.3805(b)(3)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2025-03-17","finding":"Administering Medication - Not After Expiration date: The operation had Benadryl that expired in 2/2025, Neosporin that expired in 9/2024, and Benadryl cream that expired in 7/2024.","topic":"supervision","source_record_id":"1026383881","violation_type_title":"Administering Medication - Not After Expiration date (26 TAC §746.3805(b)(3))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1393773-i20250307-v4","violation_type_id":"tx-tac-746-3819","inspection_id":"tx-hhsc-1393773-i20250307","date":"2025-03-07","original_code":"746.3819","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2025-03-14","finding":"Food Allergy Emergency Plan Signed by Parents and Health Care Professional: There were three children with food allergy plans that had doctor signatures but not parent signatures. Two of the children did not have the Benadryl allergy medication as required per the food allergy plan. Without this medication, the plan could not be implemented.","topic":"fire","source_record_id":"1026303257","violation_type_title":"Food Allergy Emergency Plan Signed by Parents and Health Care Professional (26 TAC §746.3819)","topic_label":"Fire safety & emergency drills"},{"id":"tx-hhsc-1393773-i20250307-v5","violation_type_id":"tx-tac-746-4003-a","inspection_id":"tx-hhsc-1393773-i20250307","date":"2025-03-07","original_code":"746.4003(a)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Corrected at inspection","finding":"First Aid Kit - Incomplete Kit: The first aid kid in one of three buses had expired antiseptic and was missing a thermometer. The first aid kit in a second bus was missing antiseptic, a thermometer, and tweezers. This was corrected at inspection when the person in charge removed the expired items and added the missing items.","topic":"staffing","source_record_id":"1026423932","violation_type_title":"First Aid Kit - Incomplete Kit (26 TAC §746.4003(a))","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-1393773-i20250307-v6","violation_type_id":"tx-tac-746-3401-a","inspection_id":"tx-hhsc-1393773-i20250307","date":"2025-03-07","original_code":"746.3401(a)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2025-05-29","finding":"Annual Sanitation Inspection: The annual sanitation inspection was over due and last completed on 2/9/24.","topic":"sanitation","source_record_id":"1026383880","violation_type_title":"Annual Sanitation Inspection (26 TAC §746.3401(a))","topic_label":"Sanitation & hygiene"}]},{"id":"tx-hhsc-1393773-i20240911","date":"2024-09-11","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905856252","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905856252","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2024-09-11","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1393773-i20240815","date":"2024-08-15","inspection_type":"Assessment","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905960305","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905960305","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2024-08-15","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1393773-i20240807","date":"2024-08-07","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905856251","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905856251","retrieved_at":"2026-11-05T21:27:29.71
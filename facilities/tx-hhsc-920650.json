encies cited","passed":false,"violation_count":3,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905793846","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905793846","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2026-08-19","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-920650-i20260819-v1","violation_type_id":"tx-tac-744-2005-b-2","inspection_id":"tx-hhsc-920650-i20260819","date":"2026-08-19","original_code":"744.2005(b)(2)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2026-08-27","finding":"Written Activity Plans - Outline Routines and Activities: There were no activities observed on the tables for the children to participate in. The children were running around the cafeteria and some were fighting each other, while others sat at tables waiting.","topic":"records","source_record_id":"1026249165","violation_type_title":"Written Activity Plans - Outline Routines and Activities (26 TAC §744.2005(b)(2))","topic_label":"Records, permits & program"},{"id":"tx-hhsc-920650-i20260819-v2","violation_type_id":"tx-tac-744-1205-a-4","inspection_id":"tx-hhsc-920650-i20260819","date":"2026-08-19","original_code":"744.1205(a)(4)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2026-08-27","finding":"Supervision ensures each child?s safety, well-being, including physical proximity and auditory or visual awareness of each child?s on going activity: Caregivers were observed allowing child to run in and outof the cafeteria. The children were also observed exiting the cafeteria to the inner entrance corridor, caregivers were observed threshold supervising the children as the children went to the bathroom unsupervised. Children were observed opening the exit doors for parents as the caregivers were chasing several runners in the cafeteria.","topic":"supervision","
n_id":"tx-hhsc-167601-i20220615","date":"2022-06-15","original_code":"746.1203(4)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2022-08-19","finding":"Responsibilities of Caregivers - Supervision of Children: This standard was evaluated under a DFPS investigation and is found to be deficient. A caregiver allowed a 5yo to walk out of the classroom without wearing shoes. The child was wearing socks. When the child returned to the classroom, the caregiver learned that the child had fallen and hit their eye. The injury caused the child's eye to become swollen and bruised. The caregiver failed to intervene and ensure that the child was wearing shoes.","topic":"supervision","source_record_id":"1026592426","violation_type_title":"Responsibilities of Caregivers - Supervision of Children (26 TAC §746.1203(4))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-167601-i20220615-v2","violation_type_id":"tx-tac-746-1201-1","inspection_id":"tx-hhsc-167601-i20220615","date":"2022-06-15","original_code":"746.1201(1)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2022-08-19","finding":"Responsibilities of Employees and Caregivers -Demonstrate Competency, Good Judgment, Self-control: This standard was evaluated under a DFPS investigation and is found to be deficient. Staff lacked judgment by failing to immediately notify parents of an injury occurring to a child's vital area. The child fell and hit their eye. The child's eye was swollen and bruised. The injury occurred at 1:29pm and parent was notified at 4:30pm.","topic":"staffing","source_record_id":"1026592424","violation_type_title":"Responsibilities of Employees and Caregivers -Demonstrate Competency, Good Judgment, Self-control (26 TAC §746.1201(1))","topic_label":"Staff qualifications & clearances"}]},{"id":"tx-hhsc-167601-i20220511","date":"2022-05-11","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905763714","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905763714","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-05-11","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-167601-i20220418","date":"2022-04-18","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905763713","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905763713","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-04-18","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-167601-i20220405","date":"2022-04-05","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905763712","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905763712","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-04-05","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-167601-i20220401","date":"2022-04-01","inspection_type":"Investigation of a report (self-reported)","result":"Deficiencies cited","passed":false,"violation_count":2,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905907985","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905907985","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-04-01","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-167601-i20220401-v1","violation_type_id":"tx-tac-746-1201-1","inspection_id":"tx-hhsc-167601-i20220401","date":"2022-04-01","original_code":"746.1201(1)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2022-05-11","finding":"Responsibilities of Employees and Caregivers -Demonstrate Competency, Good Judgment, Self-control: A caregiver failed to demonstrate good judgment and competency when attempting to take a toy from a 7 year old child. The caregiver received the operation's positive discipline strategies on 2/16/2022 and failed to put the training into practice in this situation.","topic":"supervision","source_record_id":"1026592423","violation_type_title":"Responsibilities of Employees and Caregivers -Demonstrate Competency, Good Judgment, Self-control (26 TAC §746.1201(1))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-167601-i20220401-v2","violation_type_id":"tx-tac-746-2803-4","inspection_id":"tx-hhsc-167601-i20220401","date":"2022-04-01","original_code":"746.2803(4)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2022-05-11","finding":"Discipline - Positive Methods of Discipline and Guidance: The caregiver failed to use positive discipline methods when a 7 year old child refused to give a toy to the caregiver. The caregiver grabbed the child's arm and took the toy. In the process, the caregiver bruised and scratched the child's arm and caused the child to fall and hit his head.","topic":"sanitation","source_record_id":"1026592422","violation_type_title":"Discipline - Positive Methods of Discipline and Guidance (26 TAC §746.2803(4))","topic_label":"Sanitation & hygiene"}]},{"id":"tx-hhsc-167601-i20211230","date":"2021-12-30","inspection_type":"Inspection","result":"Deficiencies cited","passed":false,"violation_count":1,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905763711","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905763711","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2021-12-30","evidence_class":"VERIFIED"},"occurre
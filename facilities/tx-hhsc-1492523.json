01","inspection_type":"Inspection","result":"Deficiencies cited","passed":false,"violation_count":6,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905885897","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905885897","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2026-04-01","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1492523-i20260401-v1","violation_type_id":"tx-tac-746-1601","inspection_id":"tx-hhsc-1492523-i20260401","date":"2026-04-01","original_code":"746.1601","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2026-04-14","finding":"Child/ Caregiver Ratio - 13 or More Children: A caregiver in the infant room was observed supervising 9 children alone when the specified age group was 12-17 months. A caregiver in the pre-k room was observed supervising 18 children alone when the specified age group was 3 year olds. This was corrected at inspection when caregivers stepped into both rooms bringing the operation into compliance.","topic":"supervision","source_record_id":"1026293806","violation_type_title":"Child/ Caregiver Ratio - 13 or More Children (26 TAC §746.1601)","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1492523-i20260401-v2","violation_type_id":"tx-tac-746-3301-b","inspection_id":"tx-hhsc-1492523-i20260401","date":"2026-04-01","original_code":"746.3301(b)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2026-04-14","finding":"Nutrition and Food Service - Follow Meal Patterns: A half gallon of milk was observed in the entire center for a total of 35 children in attendance. Milk was not served at lunch.","topic":"supervision","source_record_id":"1026494386","violation_type_title":"Nutrition and Food Service - Follow Meal Patterns (26 TAC §746.3301(b))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-149
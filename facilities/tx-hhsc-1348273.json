4-3y3d.json?activity_id=905839198","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2021-12-16","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1348273-i20211216-v1","violation_type_id":"tx-tac-746-1203-4","inspection_id":"tx-hhsc-1348273-i20211216","date":"2021-12-16","original_code":"746.1203(4)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2021-12-29","finding":"Responsibilities of Caregivers- Supervision of Children: Proper supervision was not established as there was only one caregiver in the building caring for 11 children of varying ages. The children were divided into two groups and in different rooms. Four infants and a toddler were observed in the infant room. Four toddlers and two pre-k children were observed in the pre-k area asleep on floor mats. The caregiver was observed in the infant room leaving the children in the pre-k area unsupervised.","topic":"supervision","source_record_id":"1026306150","violation_type_title":"Responsibilities of Caregivers - Supervision of Children (26 TAC §746.1203(4))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1348273-i20211216-v2","violation_type_id":"tx-tac-746-1701","inspection_id":"tx-hhsc-1348273-i20211216","date":"2021-12-16","original_code":"746.1701","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2021-12-29","finding":"Child/Caregiver Ratio - 12 or Fewer Children: Ratios were not met when a caregiver was caring for a total of 11 children of varying ages. The ages of  the children were Four infants 0-17 months old, and Seven children  between  18 months-4 years of age. According to the ratio chart two caregivers were required with the group of children based on the number of children in each age category.","topic":"supervision","source_record_id":"1026386780","violation_type_title":"Child/Caregiver Ratio - 12 or Fewer Children (26 TAC §746.1701)","topic_label":"Supervision & ratios"}]},{"id":"tx-hhsc-1348273-i20211130","date":"2021-11-30","inspection_type":"Inspection","result":"Deficiencies cited","passed":false,"violation_count":6,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905839197","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905839197","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2021-11-30","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1348273-i20211130-v1","violation_type_id":"tx-tac-746-5209-c","inspection_id":"tx-hhsc-1348273-i20211130","date":"2021-11-30","original_code":"746.5209(c)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2021-12-16","finding":"No Blocked or Locked Doors as Exits: A designated fire exit door was blocked with children's equipment.         Note: This was addressed with director and the equipment was removed.","topic":"staffing","source_record_id":"1026473910","violation_type_title":"No Blocked or Locked Doors as Exits (26 TAC §746.5209(c))","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-1348273-i20211130-v2","violation_type_id":"tx-tac-746-1315-a","inspection_id":"tx-hhsc-1348273-i20211130","date":"2021-11-30","original_code":"746.1315(a)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2021-12-07","finding":"Each Caregiver and the Director Must Have Current Training in pediatric first aid with rescue breathing and choking.: A caregiver did not have current training in pediatric first aid with rescue breathing and choking.","topic":"staffing","source_record_id":"1026233409","violation_type_title":"Each Caregiver and the Director Must Have Current Training in pediatric first aid with rescue breathing and choking. (26 TAC §746.1315(a))","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-1348273-i20211130-v3","violation_type
vision & ratios"},{"id":"tx-hhsc-1366137-i20241016-v3","violation_type_id":"tx-tac-746-1313","inspection_id":"tx-hhsc-1366137-i20241016","date":"2024-10-16","original_code":"746.1313","severity":"low","severity_label":"Low risk","status":"corrected","status_label":"Correction verified 2024-10-30","finding":"Time Period of Training: Upon review of caregivers training documents, one caregiver did not have the required 24 hours of annual training from the previous full year. The caregiver had a total of only 9 hours, 15 hours could not be located.","topic":"staffing","source_record_id":"1026377855","violation_type_title":"Time Period of Training (26 TAC §746.1313)","topic_label":"Staff qualifications & clearances"}]},{"id":"tx-hhsc-1366137-i20240723","date":"2024-07-23","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905844600","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905844600","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2024-07-23","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1366137-i20240719","date":"2024-07-19","inspection_type":"Investigation of a report (self-reported)","result":"Deficiencies cited","passed":false,"violation_count":2,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905940051","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905940051","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2024-07-19","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1366137-i20240719-v1","violation_type_id":"tx-tac-746-4971-2","inspection_id":"tx-hhsc-1366137-i20240719","date":"2024-07-19","original_code":"746.4971(2)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2024-08-07","finding":"
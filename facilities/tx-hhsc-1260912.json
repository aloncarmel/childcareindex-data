ate":"2023-04-17","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905814889","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905814889","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2023-04-17","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1260912-i20230413","date":"2023-04-13","inspection_type":"Investigation of a report","result":"Deficiencies cited","passed":false,"violation_count":1,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905928530","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905928530","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2023-04-13","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1260912-i20230413-v1","violation_type_id":"tx-tac-746-501-a-6","inspection_id":"tx-hhsc-1260912-i20230413","date":"2023-04-13","original_code":"746.501(a)(6)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2023-05-19","finding":"Written Operational Policies - Parental Notifications: The operation's operational policies address communication between parents and the school which includes parental notifications, methods of communication, classrooms being equipped with a phone for efficient communication between staff and management, open communication between parents and the school being integral to Kids R Kids, contacting teachers, contacting management, and emergencies. Health checks and illness and injury are also addressed in the operational policies. It is important staff and management are following their operational policies as well as minimum standards regarding communicating with parents when applicable. Information gathered in the investigation substantiated there was a lapse of communication regarding an incident where a pre-k aged child had an accident and was changed into clean underwear but no bottoms as it was believed the child did not have extra clothes. The child was present at the operation for two to three hours with their underwear being visible with no dress or shorts/pants to cover the underwear. While a caregiver initially reached out to management there was no follow up from the caregiver or management in regard to the situation with each other or with the parent. The parent was not notified.","topic":"supervision","source_record_id":"1026569411","violation_type_title":"Written Operational Policies - Parental Notifications (26 TAC §746.501(a)(6))","topic_label":"Supervision & ratios"}]},{"id":"tx-hhsc-1260912-i20221101","date":"2022-11-01","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905814888","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905814888","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-11-01","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1260912-i20220216","date":"2022-02-16","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905814887","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905814887","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-02-16","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1260912-i20220214","date":"2022-02-14","inspection_type":"Investigation of a report","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905928529","url":"https://data.texas.gov/resource/m5q4-3y3d
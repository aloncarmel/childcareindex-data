_record_id":"905863941","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905863941","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-11-09","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1423744-i20221018","date":"2022-10-18","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905863940","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905863940","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-10-18","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1423744-i20221007","date":"2022-10-07","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905863939","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905863939","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-10-07","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1423744-i20221005","date":"2022-10-05","inspection_type":"Investigation of a report","result":"Deficiencies cited","passed":false,"violation_count":1,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905946830","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905946830","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-10-05","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1423744-i20221005-v1","violation_type_id":"tx-tac-745-135","inspection_id":"tx-hhsc-1423744-i20221005","date":"2022-10-05","original_code":"745.135","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2022-12-08","finding":"Program Does Not Meet Exemption Criteria: The program was offering services that did not align with the single skilled exemption they were originally approved for.        A single skill exemption must meet the following criteria from Texas administrative code 745. 129 (2):        (A)The program offers direct instruction in a single skill, talent, ability, expertise, or proficiency;    (B) The program does not provide or offer services that are not directly related to a single skill, talent, ability, expertise, or proficiency, but may offer transportation and snacks;    (C) The program does not advertise or represent that the program is a child-care facility, day-care center, or licensed before or after-school program or that the program offers child-care services;    (D) The program informs parents that the program is not licensed by the state;     (E) The program informs parents of the physical risk a child may face while participating in the program; and    (F) The program conducts background checks using information that is obtained from the Department of Public Safety for all program employees and volunteers who work with children.        The program was found to be offering two extra-curricular activities, Tippy Toes and Soccer Shots, that are not directly related to a single skill, talent, ability, expertise, or proficiency of the Spanish language. In addition, Tippy Toes was being provided in the English Language and therefore did not meet the approved single skills exemption of Spanish Immersion Program. Other daily activities observed such as independent center time and outdoor play did not provide direct instruction of the Spanish Language as they were self-led activities.","topic":"staffing","source_record_id":"1026694436","violation_type_title":"Program Does Not Meet Exemption Criteria (26 TAC §745.135)","topic_label":"Staff qualifications & clearances"}]}],"geo":{"state":{"code":"TX","name":"Texas"},"county":{"fips":"48201","name":"Harris County"},"zip":"77008","city":"Houston"},"related":{"same_operator":[],"same_operator_
09","original_code":"747.3303(c)(2)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2024-10-23","finding":"Diaper Changing Equipment - If Above Floor Level Must Keep Hand on Child: A caregiver was observed changing a child's diaper and did not have hands securing the child. The caregiver was observed walking away from the child leaving the child on the changing table.","topic":"sanitation","source_record_id":"1026463753","violation_type_title":"Diaper Changing Equipment - If Above Floor Level Must Keep Hand on Child (26 TAC §747.3303(c)(2))","topic_label":"Sanitation & hygiene"}]},{"id":"tx-hhsc-1234809-i20231108","date":"2023-11-08","inspection_type":"Inspection","result":"Deficiencies cited","passed":false,"violation_count":4,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905810924","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905810924","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2023-11-08","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1234809-i20231108-v1","violation_type_id":"tx-tac-747-1314","inspection_id":"tx-hhsc-1234809-i20231108","date":"2023-11-08","original_code":"747.1314","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2023-11-15","finding":"Transportation Safety Training-Primary Caregiver and Employee Transporting: The primary caregiver transports children but did not have the required two hours of transportation training.","topic":"staffing","source_record_id":"1026362408","violation_type_title":"Transportation Safety Training-Primary Caregiver and Employee Transporting (26 TAC §747.1314)","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-1234809-i20231108-v2","violation_type_id":"tx-tac-747-1309-a","inspection_id":"tx-hhsc-1234809-i20231108","date":"2023-11-08","original_code":"747.1309(a)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Corrected at inspection","finding":"Primary Caregiver Annual Training -30 Hours Required: The primary caregiver had the 30 hours of required training, but was missing training in the following topics: Emergency preparedness, communicable diseases, administering medication, food allergy emergencies, premesis safety, and handling, storing, and disposing of hazardous materials. This was corrected at inspection was the evaluation period for these trainings has already ended and the primary caregiver is working on obtaining this topics for the current evaluation period.","topic":"staffing","source_record_id":"1026241861","violation_type_title":"Primary Caregiver Annual Training -30 Hours Required (26 TAC §747.1309(a))","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-1234809-i20231108-v3","violation_type_id":"tx-tac-747-3501","inspection_id":"tx-hhsc-1234809-i20231108","date":"2023-11-08","original_code":"747.3501","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Corrected at inspection","finding":"Safety - Areas Free From Hazards: The primary caregiver had a candle with hot wax sitting on a table within reach of children. There was also a bottle of bleach solution sitting on the bathroom counter within reach of older children. These were corrected at inspection when the primary caregiver removed the candle and bleach and set them out of the reach of children.","topic":"safety","source_record_id":"1026442463","violation_type_title":"Safety - Areas Free From Hazards (26 TAC §747.3501)","topic_label":"Safety hazards"},{"id":"tx-hhsc-1234809-i20231108-v4","violation_type_id":"tx-tac-747-3935-b","inspection_id":"tx-hhsc-1234809-i20231108","date":"2023-11-08","original_code":"747.3935(b)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Corrected at inspection","finding":"Child
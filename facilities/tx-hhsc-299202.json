ing","source_record_id":"1026594398","violation_type_title":"Responsibilities of Employees and Caregivers -Demonstrate Competency, Good Judgment, Self-control (26 TAC §746.1201(1))","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-299202-i20240307-v2","violation_type_id":"tx-tac-746-2805-3","inspection_id":"tx-hhsc-299202-i20240307","date":"2024-03-07","original_code":"746.2805(3)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2024-04-09","finding":"Prohibited Punishments - Grabbing and Pulling: Information gathered in the investigation substantiated that a caregiver grabbed and pulled a child when stopping them from running and while trying to get them to go to their nap mat and to lay down.","topic":"facilities","source_record_id":"1026594399","violation_type_title":"Prohibited Punishments - Grabbing and Pulling (26 TAC §746.2805(3))","topic_label":"Facilities & equipment"},{"id":"tx-hhsc-299202-i20240307-v3","violation_type_id":"tx-tac-746-2905-1","inspection_id":"tx-hhsc-299202-i20240307","date":"2024-03-07","original_code":"746.2905(1)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2024-04-09","finding":"Children Not Required to Sleep - May Not Force Child to Sleep: Information gathered in the investigation substantiated that a caregiver inappropriately tried to get and keep a child to stay on their nap mat and sleep by wrapping them in their blanket as well as trying to keep them in place on the mat.","topic":"facilities","source_record_id":"1026594397","violation_type_title":"Children Not Required to Sleep - May Not Force Child to Sleep (26 TAC §746.2905(1))","topic_label":"Facilities & equipment"}]},{"id":"tx-hhsc-299202-i20231030","date":"2023-10-30","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc
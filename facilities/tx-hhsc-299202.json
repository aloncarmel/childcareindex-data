ion_type_title":"Responsibilities of Caregivers - Know children responsible for (26 TAC §746.1205(a)(1))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-299202-i20241003-v3","violation_type_id":"tx-tac-746-701-5","inspection_id":"tx-hhsc-299202-i20241003","date":"2024-10-03","original_code":"746.701(5)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2024-10-07","finding":"Licensing Incident/Illness Report Form - Situations Placing Children at Risk: An incident report was not completed as required for a non-routine situation that occurred in care that placed a child at risk.","topic":"health","source_record_id":"1026594402","violation_type_title":"Licensing Incident/Illness Report Form - Situations Placing Children at Risk (26 TAC §746.701(5))","topic_label":"Health records & medication"},{"id":"tx-hhsc-299202-i20241003-v4","violation_type_id":"tx-tac-746-1205-a-4","inspection_id":"tx-hhsc-299202-i20241003","date":"2024-10-03","original_code":"746.1205(a)(4)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2024-10-15","finding":"Supervision ensures each child?s safety, well-being, including physical proximity and auditory or visual awareness of each child?s on going activity: Supervision was not maintained as required when a child in care was left alone unsupervised for approximately twenty-three minutes during a transition from the classroom to the bathroom and playground.","topic":"supervision","source_record_id":"1026594403","violation_type_title":"Supervision ensures each child?s safety, well-being, including physical proximity and auditory or visual awareness of each child?s on going activity (26 TAC §746.1205(a)(4))","topic_label":"Supervision & ratios"}]},{"id":"tx-hhsc-299202-i20240919","date":"2024-09-19","inspection_type":"Inspection","result":"Deficiencies cited","passed":false,"violation_count":1,"open_count":0,"evidence_class":"VERIF
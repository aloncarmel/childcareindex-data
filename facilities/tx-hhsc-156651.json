:"2025-11-19","original_code":"746.1205(a)(4)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2025-12-02","finding":"Supervision ensures each child?s safety, well-being, including physical proximity and auditory or visual awareness of each child?s on going activity: Based on the evidence obtained, a caregiver failed to conduct an accurate count of the children they were responsible for when transitioning from the playground to the classroom. This resulted in one child being left on the playground for 10 minutes. Other caregivers and children remained on the playground but none of the caregivers on the playground were aware that the child was left nor that they would be responsible for ensuring responsibility for the child. The caregivers that were aware they were responsible for the child were not within physical proximity when they entered the building and lost both auditory and visual awareness of the child during those 10 minutes.","topic":"supervision","source_record_id":"1026666587","violation_type_title":"Supervision ensures each child?s safety, well-being, including physical proximity and auditory or visual awareness of each child?s on going activity (26 TAC §746.1205(a)(4))","topic_label":"Supervision & ratios"}]},{"id":"tx-hhsc-156651-i20250904","date":"2025-09-04","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905761066","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905761066","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2025-09-04","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-156651-i20250826","date":"2025-08-26","inspection_type":"Investigation of a report","result":"Deficiencies cited","passed":false,"violation_count":1,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":
e_record_id":"905832622","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905832622","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2024-04-11","evidence_class":"VERIFIED"},"occurrences":[]},{"id":"tx-hhsc-1332779-i20240221","date":"2024-02-21","inspection_type":"Investigation of a report","result":"Deficiencies cited","passed":false,"violation_count":3,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905935279","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905935279","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2024-02-21","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1332779-i20240221-v1","violation_type_id":"tx-tac-746-2805-2","inspection_id":"tx-hhsc-1332779-i20240221","date":"2024-02-21","original_code":"746.2805(2)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2024-06-13","finding":"Prohibited Punishments -  Associated with Food, Naps, or Toilet Training: This standard was evaluated as part of an investigation by the Department of Family and Protective Services and was found to be deficient. The caregiver threw away food before children were done eating, forced a child to use the bathroom, and yanked a mat from underneath a child during nap time. Specific incidents include discarding a child's food for talking too much, forcing bathroom use against their will, and disrupting naps by pulling away mats, causing children to fall. These actions were confirmed by multiple interviews with caregivers who observed these inappropriate disciplinary measures.","topic":"staffing","source_record_id":"1026648422","violation_type_title":"Prohibited Punishments -  Associated with Food, Naps, or Toilet Training (26 TAC §746.2805(2))","topic_label":"Staff qualifications & clearances"},{"id":"tx-hhsc-1332779-i20240221-v2","violation_type_id":"tx-tac-746-2805-6","inspection_id":"tx-hhsc-1332779-i20240221","date":"2024-02-21","original_code":"746.2805(6)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2024-06-13","finding":"Prohibited Punishments - Using Harsh, Abusive or Profane Language: This standard was evaluated as part of an investigation by the Department of Family and Protective Services and was found to be deficient. Multiple testimonies indicated the caregiver used verbally harsh and abusive language. Witnesses reported the caregiver used derogatory and demeaning language, creating an emotionally harmful environment.","topic":"records","source_record_id":"1026657874","violation_type_title":"Prohibited Punishments - Humiliating, Rejecting, Yelling (26 TAC §746.2805(6))","topic_label":"Records, permits & program"},{"id":"tx-hhsc-1332779-i20240221-v3","violation_type_id":"tx-tac-746-2805-1","inspection_id":"tx-hhsc-1332779-i20240221","date":"2024-02-21","original_code":"746.2805(1)","severity":"high","severity_label":"High risk","status":"corrected","status_label":"Correction verified 2024-06-13","finding":"Prohibited Punishments - Corporal Punishment: This standard was evaluated as part of an investigation by the Department of Family and Protective Services and was found to be deficient. The caregiver's actions were aggressive and included grabbing and verbal threats. Witnesses reported the caregiver yanked a child's jacket, pulled a child by the wrist, and used threats to control behavior. Multiple interviews with caregivers confirmed these actions, indicating a pattern of aggressive behavior.","topic":"records","source_record_id":"1026657235","violation_type_title":"Prohibited Punishments - Corporal Punishment (26 TAC §746.2805(1))","topic_label":"Records, permits & program"}]},{"id":"tx-hhsc-1332779-i20240131","date":"2024-01-31","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance"
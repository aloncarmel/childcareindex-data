/m5q4-3y3d.json?activity_id=905847701","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2023-01-06","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1373501-i20230106-v1","violation_type_id":"tx-tac-746-1203-3","inspection_id":"tx-hhsc-1373501-i20230106","date":"2023-01-06","original_code":"746.1203(3)","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2023-01-11","finding":"Responsibilities of Caregivers - Know Children's Names and Ages: Staff was not familiar with the ages of four children napping in the multi-purpose room. Staff supervising the toddler and prek children did not know how many children were in care.","topic":"supervision","source_record_id":"1026468982","violation_type_title":"Responsibilities of Caregivers - Know Children's Names and Ages (26 TAC §746.1203(3))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1373501-i20230106-v2","violation_type_id":"tx-tac-746-1601","inspection_id":"tx-hhsc-1373501-i20230106","date":"2023-01-06","original_code":"746.1601","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2023-01-11","finding":"Child/ Caregiver Ratio - 13 or More Children: One caregiver was supervising a group of eight napping children ages 12mo, 12mo, 14mo, 15mo, 18mo, 18mo, 18mo and 19mo.","topic":"supervision","source_record_id":"1026308462","violation_type_title":"Child/ Caregiver Ratio - 13 or More Children (26 TAC §746.1601)","topic_label":"Supervision & ratios"}]},{"id":"tx-hhsc-1373501-i20220907","date":"2022-09-07","inspection_type":"Inspection","result":"No deficiencies cited","passed":true,"violation_count":0,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905847700","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905847700","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2022-09-07","ev
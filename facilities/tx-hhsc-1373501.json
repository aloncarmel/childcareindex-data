ion","source_record_id":"1026290749","violation_type_title":"Written Activity Plans (26 TAC §746.2203(a))","topic_label":"Supervision & ratios"},{"id":"tx-hhsc-1373501-i20240130-v5","violation_type_id":"tx-tac-746-1601","inspection_id":"tx-hhsc-1373501-i20240130","date":"2024-01-30","original_code":"746.1601","severity":"medium_high","severity_label":"Medium-high risk","status":"corrected","status_label":"Correction verified 2024-02-12","finding":"Child/ Caregiver Ratio - 13 or More Children: One caregiver was supervising a group of 9 children ages 7mo to 27mo, specified age group was 12-17mo. Operation was over ratio by 4 children and age difference between the youngest and oldest child exceeded 18months.","topic":"supervision","source_record_id":"1026411593","violation_type_title":"Child/ Caregiver Ratio - 13 or More Children (26 TAC §746.1601)","topic_label":"Supervision & ratios"}]},{"id":"tx-hhsc-1373501-i20230810","date":"2023-08-10","inspection_type":"Inspection","result":"Deficiencies cited","passed":false,"violation_count":1,"open_count":0,"evidence_class":"VERIFIED","provenance":{"source_id":"tx_hhsc_activities","source_record_id":"905847704","url":"https://data.texas.gov/resource/m5q4-3y3d.json?activity_id=905847704","retrieved_at":"2026-11-05T21:27:29.718Z","effective_date":"2023-08-10","evidence_class":"VERIFIED"},"occurrences":[{"id":"tx-hhsc-1373501-i20230810-v1","violation_type_id":"tx-tac-746-603-a-4","inspection_id":"tx-hhsc-1373501-i20230810","date":"2023-08-10","original_code":"746.603(a)(4)","severity":"medium","severity_label":"Medium risk","status":"corrected","status_label":"Correction verified 2023-08-14","finding":"Children's Records - Immunizations: Two out of eight children's files reviewed are missing immunization records.","topic":"health","source_record_id":"1026407806","violation_type_title":"Children's Records - Immunizations (26 TAC §746.603(a)(4))","topic_label":"Health records & medication"}]},{"id":"tx-hhsc-1373501-i20230411","da